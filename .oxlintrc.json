{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "off",
    "suspicious": "off",
    "pedantic": "off",
    "perf": "off",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "ignorePatterns": [
    "node_modules/**",
    "build/**",
    "dist/**",
    "docs/**",
    "examples/**",
    "site/**",
    "src/exp/**"
  ],
  "jsPlugins": ["./scripts/oxlint-plugin-cami.js"],
  "rules": {
    "cami/filename-convention": "off",
    "cami/cami-rules": "error",
    "cami/cami-field-invariants": "error",
    "no-debugger": "error"
  },
  "overrides": [
    {
      "files": ["tests/**/*.{js,ts}"],
      "rules": {
        "cami/cami-rules": "off"
      }
    }
  ]
}
